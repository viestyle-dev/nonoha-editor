{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "rules": {
    "react/display-name": "off",
    "@typescript-eslint/no-unused-vars": "off"
  },
  "overrides": [
    {
      "files": ["packages/nonoha-views/src/**/*.ts"],
      "excludedFiles": ["packages/nonoha-views/src/__tests__/**"],
      "rules": {
        "@typescript-eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "nonoha-client-js",
                "message": "nonoha-views uses nonoha-client-js for types only: hosts pass the clients in.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    }
  ]
}
